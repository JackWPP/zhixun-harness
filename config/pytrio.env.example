# PyTRiO OpenAI-compatible endpoint (contest-provided driving model).
# Copy to .scratch/pytrio.env and fill LLM_API_KEY; never commit real keys.
LLM_PROVIDER=openai
LLM_BASE_URL=https://pytrio.com/api/openai/v1
LLM_API_KEY=trio_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The platform allows Qwen/Qwen3.8-27B and Qwen/Qwen3.5-4B.
LLM_MODEL=Qwen/Qwen3.8-27B
LLM_CONTEXT_WINDOW=64000
